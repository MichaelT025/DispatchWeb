{
	"name": "piastra-web-ui",
	"version": "0.82.0",
	"description": "PiAstra web UI — a Codex-style browser shell for the pi coding agent",
	"license": "MIT",
	"type": "module",
	"bin": {
		"pi-web-ui": "bin/pi-web-ui.mjs"
	},
	"main": "bin/pi-web-ui.mjs",
	"files": [
		"bin/",
		"dist/",
		"web/dist/",
		"web/public/",
		"deploy/",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"pi",
		"coding-agent",
		"ai",
		"chat",
		"web-ui",
		"terminal",
		"llm"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MichaelT025/PiAstra-web-ui.git"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"prepublishOnly": "npm run build",
		"dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
		"dev:server": "cross-env PI_WEB_PORT=8788 PI_WEB_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 node --watch --import tsx server/index.ts",
		"dev:web": "vite --config web/vite.config.ts",
		"build": "npm run build:web && npm run build:server",
		"build:web": "vite build --config web/vite.config.ts",
		"build:server": "tsc -p tsconfig.server.json",
		"typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
		"test": "vitest run",
		"test:unit": "vitest run",
		"test:smoke": "node tests/run-smoke.mjs",
		"check:protocol": "node scripts/check-protocol-sync.mjs",
		"test:freeze": "node tests/freeze-test.mjs",
		"start": "node dist/server/index.js",
		"format": "prettier --write server/ web/src/ scripts/ bin/ tests/*.mjs tests/unit/ tests/lib/ .github/workflows/ci.yml package.json README.md",
		"format:check": "prettier --check server/ web/src/ scripts/ bin/ tests/*.mjs tests/unit/ tests/lib/ .github/workflows/ci.yml package.json README.md",
		"lint": "oxlint server/ web/src/ scripts/",
		"lint:fix": "oxlint --fix server/ web/src/ scripts/",
		"check": "npm run format:check && npm run lint && npm run check:protocol && npm run typecheck",
		"ci": "npm run check && npm run build && npm test && npm run test:smoke && npm run test:browser",
		"test:browser": "node tests/run-browser.mjs"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"compression": "^1.8.1",
		"express": "^4.21.2",
		"highlight.js": "^11.10.0",
		"katex": "^0.16.47",
		"node-pty": "^1.1.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-icons": "^5.7.0",
		"react-markdown": "^9.0.1",
		"rehype-highlight": "^7.0.1",
		"rehype-katex": "^7.0.1",
		"rehype-raw": "^7.0.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.0",
		"remark-math": "^6.0.0",
		"typebox": "^1.3.14",
		"ws": "^8.18.0"
	},
	"devDependencies": {
		"@types/compression": "^1.8.1",
		"@types/express": "^4.17.21",
		"@types/node": "^22.10.0",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@types/ws": "^8.5.13",
		"@vitejs/plugin-react": "^4.3.4",
		"concurrently": "^9.1.0",
		"cross-env": "^10.1.0",
		"jsdom": "^26.1.0",
		"oxlint": "^1.81.0",
		"playwright-core": "^1.62.1",
		"prettier": "^3.9.6",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"vite": "^6.0.3",
		"vitest": "^4.1.11"
	},
	"allowScripts": {
		"node-pty@1.1.0": true
	}
}
